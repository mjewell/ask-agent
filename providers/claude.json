{
  "binary": "claude",
  "prompt_transport": "stdin",
  "model_args": ["--model", "{model}"],
  "effort_args": ["--effort", "{effort}"],
  "passthrough_position": 0,
  "reserved_args": ["--print", "-p", "--output-format", "--resume", "-r", "--permission-mode", "--permission-prompts", "--model", "--effort"],
  "catalog_as_of": "2026-09-19",
  "models": [
    {
      "id": "claude-sonnet-5",
      "cli_choices": ["default", "sonnet"],
      "input_usd_per_mtok": 2.0,
      "output_usd_per_mtok": 10.0,
      "effort_options": ["low", "medium", "high", "xhigh", "max"],
      "description": "Efficient routine-task model; the Claude CLI default and the sonnet alias."
    },
    {
      "id": "claude-opus-5",
      "cli_choices": ["opus"],
      "input_usd_per_mtok": 5.0,
      "output_usd_per_mtok": 25.0,
      "effort_options": ["low", "medium", "high", "xhigh", "max"],
      "description": "Everyday complex-task model; CLI alias: opus; roughly 2× the Claude Code usage of Sonnet."
    },
    {
      "id": "claude-fable-5-1",
      "cli_choices": ["fable"],
      "input_usd_per_mtok": 10.0,
      "output_usd_per_mtok": 50.0,
      "effort_options": ["low", "medium", "high", "xhigh", "max"],
      "description": "Most capable model for hardest, longest-running tasks; CLI alias: fable; requires usage credits."
    },
    {
      "id": "claude-haiku-4-5",
      "cli_choices": ["haiku"],
      "input_usd_per_mtok": 1.0,
      "output_usd_per_mtok": 5.0,
      "effort_options": ["low", "medium", "high", "xhigh", "max"],
      "description": "Fastest option for quick answers; CLI alias: haiku."
    }
  ],
  "new": ["--print", "--verbose", "--output-format", "stream-json", "--permission-mode", "{permission}", "--permission-prompts", "none"],
  "resume": ["--print", "--verbose", "--output-format", "stream-json", "--resume", "{session_id}", "--permission-prompts", "none"],
  "session_id_regex": "\\\"session_id\\\"\\s*:\\s*\\\"([^\\\"]+)\\\"",
  "policies": {
    "read-only": { "permission": "plan" },
    "workspace-write": { "permission": "acceptEdits" },
    "unrestricted": { "permission": "bypassPermissions" }
  }
}
