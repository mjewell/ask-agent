{
  "binary": "codex",
  "prompt_transport": "stdin",
  "model_args": ["--model", "{model}"],
  "effort_args": ["-c", "model_reasoning_effort=\"{effort}\""],
  "passthrough_position": 1,
  "reserved_args": ["--json", "--output-last-message", "--sandbox", "-s", "--cd", "-C", "--model", "-m", "--config", "-c"],
  "catalog_as_of": "2026-09-19",
  "models": [
    {
      "id": "gpt-5.6-sol",
      "input_usd_per_mtok": 4.0,
      "output_usd_per_mtok": 20.0,
      "effort_options": ["none", "low", "medium", "high", "xhigh", "max"],
      "description": "Flagship general model for complex professional work."
    },
    {
      "id": "gpt-6-astra",
      "input_usd_per_mtok": 10.0,
      "output_usd_per_mtok": 50.0,
      "effort_options": ["low", "medium", "high", "xhigh", "max", "ultra"],
      "description": "Most capable option for complex, demanding work."
    },
    {
      "id": "gpt-5.6-terra",
      "input_usd_per_mtok": 2.0,
      "output_usd_per_mtok": 12.0,
      "effort_options": ["none", "low", "medium", "high", "xhigh", "max"],
      "description": "General model balancing intelligence and cost."
    },
    {
      "id": "gpt-5.6-luna",
      "input_usd_per_mtok": 0.2,
      "output_usd_per_mtok": 1.2,
      "effort_options": ["none", "low", "medium", "high", "xhigh", "max"],
      "description": "Cost-sensitive, high-volume general work."
    }
  ],
  "new": ["exec", "--json", "-C", "{cwd}", "-s", "{sandbox}", "-"],
  "resume": ["exec", "resume", "--json", "{session_id}", "-"],
  "session_id_regex": "\\\"thread_id\\\"\\s*:\\s*\\\"([^\\\"]+)\\\"",
  "policies": {
    "read-only": { "sandbox": "read-only" },
    "workspace-write": { "sandbox": "workspace-write" },
    "unrestricted": { "sandbox": "danger-full-access" }
  }
}
